apiVersion: v1
kind: Secret
metadata:
  name: temporal-oauth-secret
  namespace: default
type: Opaque
stringData:
  # Obtained from https://git.fairfaxmedia.net/user/settings/applications
  # or Organization Settings -> Applications -> Manage OAuth2 Applications
  client-id: "YOUR_GITEA_CLIENT_ID"
  client-secret: "YOUR_GITEA_CLIENT_SECRET"
