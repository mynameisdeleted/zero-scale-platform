[Unit]
Description=Zero-Scale Gateway Proxy
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c "echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || true"
ExecStart=/usr/local/bin/gateway -idle-timeout=10s -check-period=2s
Restart=always
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
